{
  "name": "pandora-agent",
  "version": "2.0.0-beta.7",
  "description": "Verified native launcher for the Pandora Agent CLI",
  "license": "Apache-2.0",
  "repository": "github:anisayakmitra-in/AGENT-PANDORA",
  "homepage": "https://github.com/anisayakmitra-in/AGENT-PANDORA",
  "bugs": "https://github.com/anisayakmitra-in/AGENT-PANDORA/issues",
  "keywords": ["pandora", "agent", "automation", "cli", "rust"],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "require": "./lib/index.js"
    },
    "./release": {
      "types": "./lib/release.d.ts",
      "require": "./lib/release.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json"
  },
  "bin": {
    "pandora": "bin/pandora.js"
  },
  "files": [
    "bin",
    "lib"
  ],
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
